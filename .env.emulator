# Used by `npm run dev:emulator` (Vite mode "emulator"); overrides .env.
# Points the app at the local Firebase emulators with a demo project, so local
# testing never touches production data. No secrets here — safe to commit.
VITE_USE_FIREBASE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-indic.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-indic
VITE_FIREBASE_STORAGE_BUCKET=demo-indic.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:demo
VITE_FIREBASE_MEASUREMENT_ID=

# Uploads go to the real R2 Worker, which only accepts production login tokens,
# so uploads are disabled when running against the emulators.
VITE_R2_UPLOAD_WORKER_URL=
