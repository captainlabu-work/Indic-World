rules_version = '2';

// Indic World — Firebase Storage security rules.
//
// Users can only write inside folders named after their own UID, and only images
// (JPEG, PNG, WebP, AVIF) or videos (MP4, MOV, WebM) within size limits. The same
// limits are enforced for Cloudflare R2 uploads in worker/src/index.js.
// Tests: tests/rules/storage.rules.test.js (`npm run test:rules`).

service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|avif)');
    }

    function isVideo() {
      return request.resource.contentType.matches('video/(mp4|quicktime|webm)');
    }

    function isUnderMB(mb) {
      return request.resource.size <= mb * 1024 * 1024;
    }

    // Profile photo: one file per user (Settings page), max 5 MB
    match /profile-photos/{uid} {
      allow read: if true;
      allow create, update: if isOwner(uid) && isImage() && isUnderMB(5);
      allow delete: if isOwner(uid);
    }

    match /avatars/{uid}/{file=**} {
      allow read: if true;
      allow create, update: if isOwner(uid) && isImage() && isUnderMB(5);
      allow delete: if isOwner(uid);
    }

    // Story images and thumbnails, max 15 MB
    match /articles/{uid}/{file=**} {
      allow create, update: if isOwner(uid) && isImage() && isUnderMB(15);
      allow delete: if isOwner(uid);
    }

    // Motion videos, max 750 MB
    match /videos/{uid}/{file=**} {
      allow create, update: if isOwner(uid) && isVideo() && isUnderMB(750);
      allow delete: if isOwner(uid);
    }

    // Files uploaded before per-user folders stay publicly readable but can no
    // longer be written. Everything else is denied.
    match /articles/{path=**} {
      allow read: if true;
    }
    match /videos/{path=**} {
      allow read: if true;
    }
    match /article-images/{path=**} {
      allow read: if true;
    }
  }
}
